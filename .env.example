#APP CONFIG
APP_NAME="Between Us backend"
APP_NODE_ENV=development
APP_LANGUAGE=en
APP_TIMEZONE=Africa/Cairo


# CORS CONFIG
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=[]


# SWAGGER AUTH
SWAGGER_API_NAME="Between Us APIs Specification"
SWAGGER_API_VERSION="1.0"
SWAGGER_API_SECOND_SERVER_URL=""
SWAGGER_API_ROUTE="/api-docs"
SWAGGER_API_TAB_NAME="Between Us Swagger Documentation"
USE_DOCUMENTATION="SCALAR"

# PORT
APP_PORT=5000

# SOCKET
SOCKET_PORT=7000

# API VERSIONING
API_PREFIX=v
API_VERSION=1

# DATABASE
DATABASE_URI=

# REDIS
REDIS_PORT=6379

# USER AUTH
USER_AUTH_JWT_SECRET=
USER_AUTH_JWT_ACCESS_TOKEN_EXPIRATION=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# STAFF AUTH
STAFF_AUTH_JWT_SECRET=
STAFF_AUTH_JWT_ACCESS_TOKEN_EXPIRATION=


